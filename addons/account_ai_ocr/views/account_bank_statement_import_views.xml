<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="account_bank_statement_excel_import_form" model="ir.ui.view">
        <field name="name">account.bank.statement.excel.import.form</field>
        <field name="model">account.bank.statement.excel.import</field>
        <field name="arch" type="xml">
            <form string="Import Bank Statement">
                <group>
                    <field name="file_data" filename="file_name" widget="binary"/>
                    <field name="file_name" invisible="1"/>
                    <field name="journal_id"/>
                </group>
                <footer>
                    <button name="action_import" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action to open wizard -->
    <record id="action_account_bank_statement_excel_import" model="ir.actions.act_window">
        <field name="name">Import Bank Statement (Excel)</field>
        <field name="res_model">account.bank.statement.excel.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Menu item under Customers → Import Bank Statement -->
    <menuitem id="menu_import_bank_statement"
              name="Import Bank Statement"
              parent="account.menu_finance_receivables"
              action="action_account_bank_statement_excel_import"
              sequence="16"/>

    <!-- Menu item under Vendors → Import Bank Statement -->
    <menuitem id="menu_import_bank_statement_vendor"
              name="Import Bank Statement"
              parent="account.menu_finance_payables"
              action="action_account_bank_statement_excel_import"
              sequence="21"/>
</odoo>
