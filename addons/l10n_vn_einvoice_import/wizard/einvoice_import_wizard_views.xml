<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="l10n_vn_einvoice_import_wizard_form" model="ir.ui.view">
        <field name="name">l10n_vn_einvoice_import.wizard.form</field>
        <field name="model">l10n_vn_einvoice_import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Vietnamese E-Invoice">
                <group>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                </group>
                <group invisible="not import_status">
                    <field name="import_status" readonly="1"/>
                </group>
                <footer>
                    <button string="Import" name="action_import" type="object"
                            class="btn-primary" default_focus="1"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_vn_einvoice_import" model="ir.actions.act_window">
        <field name="name">Import E-Invoice</field>
        <field name="res_model">l10n_vn_einvoice_import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
